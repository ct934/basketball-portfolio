rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "kvVMmR7vjQPQ7ROJVRYk9JVg4ld2";
    }

    // This collection is the live access list. Rules do not need to be
    // redeployed for each approval: setting approved=true immediately changes
    // the result of this function for that account.
    function isApproved(uid) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/registrations/$(uid)) &&
        get(/databases/$(database)/documents/registrations/$(uid)).data.approved == true
      );
    }

    // Email/password account registrations, awaiting your approval.
    //   • the account itself can read its own status (to show "pending")
    //   • you can read any one, and list/query the whole pending set (for
    //     the admin approval panel)
    //   • an account can CREATE its own doc, but only as approved: false -
    //     it can never approve itself
    //   • only you can approve (update) or deny (delete) a registration
    match /registrations/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.approved == false
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'approved', 'requestedAt']);
      allow update: if isAdmin()
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }

    // Scouting reports:
    //   • anyone can READ (so your public player pages can display the logs)
    //   • only YOU can WRITE (create / edit / delete)
    match /reports/{reportId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Board ranking / site metadata, including manual player corrections
    // (meta/playerCorrections - see core.js applyPlayerCorrections):
    //   • anyone can READ (public board/table uses it to correct player data)
    //   • only YOU can WRITE
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- CBB Hub saved players ---
    // Any signed-in AND APPROVED user can save/star players, but only into
    // their OWN uid's subcollection. No one can read or write another
    // user's saved list -- this is what makes "multiple accounts" work
    // correctly (each account only ever sees its own saved players).
    match /users/{uid}/savedPlayers/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == uid && isApproved(uid);
    }

    // CBB Hub custom boards. Each approved account can only access its own boards.
    match /users/{uid}/boards/{boardId} {
      allow read, write: if request.auth != null && request.auth.uid == uid && isApproved(uid);
    }

    // Lock everything else down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
